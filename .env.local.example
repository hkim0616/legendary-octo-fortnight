# ─────────────────────────────────────────────────────────────
# Upstash Redis (required for Vercel deployment)
# ─────────────────────────────────────────────────────────────
# 1. Go to Vercel Dashboard → Integrations → search "Upstash"
# 2. Create a Redis database and connect it to your project
# 3. Vercel auto-injects these env vars, or copy them manually:
#      Upstash Console → Database → REST API
#
# For local development: leave these empty to use file-based
# storage at data/calendars.json (no external service needed).

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
